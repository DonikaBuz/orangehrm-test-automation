{
  "name": "orangehrm-test-automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare:reports": "node -e \"require('node:fs').mkdirSync('reports', { recursive: true })\"",
    "test": "npm run build && npm run prepare:reports && node scripts/run-cucumber.cjs",
    "test:sanity": "npm test -- --tags \"@sanity and not @regression\"",
    "test:regression": "npm test -- --tags @regression",
    "test:dry-run": "npm test -- --dry-run",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DonikaBuz/orangehrm-test-automation.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/DonikaBuz/orangehrm-test-automation/issues"
  },
  "homepage": "https://github.com/DonikaBuz/orangehrm-test-automation#readme",
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "dependencies": {
    "dotenv": "^18.0.5"
  }
}
